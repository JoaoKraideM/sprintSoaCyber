SERVER_HOST=127.0.0.1
SERVER_PORT=8000
APP_ENV=development

SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PAYLOAD_SECRET_HMAC=troque-esta-chave-hmac
DATA_ENCRYPTION_KEY=
ENCRYPT_UPLOADS_AT_REST=true
REQUIRE_PAYLOAD_SIGNATURE=false
PAYLOAD_SIGNATURE_EXEMPT_PATHS=/api/v1/auth/register,/api/v1/auth/login
PAYLOAD_SIGNATURE_MAX_AGE_SECONDS=300
FORCE_HTTPS=false
SSL_CERTFILE=
SSL_KEYFILE=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veiculos_db
DB_CHARSET=utf8mb4

UPLOAD_DIR=data/uploads
MAX_UPLOAD_FILE_SIZE_MB=10
MAX_CONTENT_LENGTH_KB=50
MAX_EXCEL_ROWS=5000
MAX_EXCEL_COLUMNS=200
ANONYMIZE_AUDIT_PII=true
AUDIT_LOG_RETENTION_DAYS=365
AUTH_LOG_RETENTION_DAYS=180
UPLOAD_RETENTION_DAYS=90
